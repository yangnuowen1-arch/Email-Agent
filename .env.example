# Email-Agent 环境变量示例
# 复制为 .env 并按需修改： cp .env.example .env
# 注意：.env 已在 .gitignore 中，切勿提交真实密码

# PostgreSQL 连接（必填）
# 格式：postgresql+psycopg://user:password@host:port/dbname
# 必须使用 psycopg v3 驱动（postgresql+psycopg://），不再兼容 postgresql:// / psycopg2
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/email_agent

# 连接池（可选，阶段2生效）
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10

# 邮件监听（可选，listen 命令生效）
# LISTEN_IDLE_PING_SECONDS=60
# LISTEN_BACKOFF_INITIAL_SECONDS=1
# LISTEN_BACKOFF_MAX_SECONDS=60

# 日志级别（可选，阶段5生效）
# LOG_LEVEL=INFO

# LLM 智能体（OpenAI 兼容网关，运行 agent 命令时必填 LLM_API_KEY）
# LLM_API_KEY=sk-xxx
# LLM_MODEL=hy3
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT_SECONDS=120

# 腾讯云 COS 对象存储（附件字节存储；未配置则附件仅落元数据）
# COS_SECRET_ID=AKIDxxx
# COS_SECRET_KEY=xxx
# COS_BUCKET=email-agent-1250000000
# COS_REGION=ap-guangzhou

# 视觉模型（识别图片附件用；未配置则跳过图片识别）
# LLM_VISION_MODEL=glm-4v-flash
