# Email-Agent 环境变量示例
# 复制为 .env 并按需修改： cp .env.example .env
# 注意：.env 已在 .gitignore 中，切勿提交真实密码

# PostgreSQL 连接（必填）
# 格式：postgresql+psycopg://user:password@host:port/dbname
# 必须使用 psycopg v3 驱动（postgresql+psycopg://），不再兼容 postgresql:// / psycopg2
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/email_agent

# 数据库连接池（可选）
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10

# 同步并发与单账号超时（可选）
# SYNC_MAX_WORKERS=5
# SYNC_TIMEOUT_SECONDS=60

# 日志级别（可选）
# LOG_LEVEL=INFO

# Gemini Developer API（可选；仅供 API/worker 显式创建 Gemini gateway 时使用）
# 请只填写刚生成的 Google AI Studio API key，切勿提交 .env 或把密钥贴到聊天中。
# GEMINI_API_KEY=your_new_gemini_api_key
# GEMINI_MODEL=gemini-3.6-flash
# 单次 Gemini 请求的超时时间（秒），支持小数；默认 30。
# GEMINI_TIMEOUT_SECONDS=30

# 本机 workflow CLI 验收 profile（可选；不是生产认证机制）
# profile 名只可由命令行选择；actor、角色和账号范围始终从这里解析，
# 不要把它们做成 CLI 参数。下面的 account ID 1 仅为示例，请改成测试邮箱账号的真实 ID。
# WORKFLOW_CLI_PROFILES_JSON='{"author":{"actor_id":"local-author","roles":["author"],"allowed_account_ids":[1]},"reviewer":{"actor_id":"local-reviewer","roles":["reviewer"],"allowed_account_ids":[1]}}'
