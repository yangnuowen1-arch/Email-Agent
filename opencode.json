{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "ls *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "tree *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "which *": "allow",
      "pwd": "allow",
      "git log *": "allow"
    }
  },
  "lsp": true,
  "mcp": {
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@sigma4life/postgres-mcp-server"],
      "enabled": true,
      "environment": {
        "DATABASE_URL": "postgresql://admin:123456@192.168.31.25:5432/email_agent",
        "SCHEMA_ONLY_MODE": "true"
      }
    }
  }
}
